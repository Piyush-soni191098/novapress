# ────────────────────────────────────────────────────────────
#  Personalized News Intelligence Platform — environment template
#  Copy this file to .env and fill in real values.
#  Never commit .env to Git.
# ────────────────────────────────────────────────────────────

# ── News Providers ────────────────────────────────────────────
# NewsAPI (https://newsapi.org/)
NEWSAPI_API_KEY=

# GNews (https://gnews.io/)
GNEWS_API_KEY=

# Marketaux financial news (https://www.marketaux.com/)
MARKETAUX_API_TOKEN=

# ── Supabase ──────────────────────────────────────────────────
# Your project URL: Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to use in backend; do NOT use in browser if you
# also need service-role; for frontend use VITE_SUPABASE_ANON_KEY in config.js)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZmc2xmdmxxcWpiYmZ6aGR0Y2duIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA0MjI5OTcsImV4cCI6MjEwNTk5ODk5N30.cT3sKuEviARRbS-y5vAfs-pRumdLmLss1FtBiZ9dJ5w

# Service-role key — BACKEND ONLY, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZmc2xmdmxxcWpiYmZ6aGR0Y2duIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDQyMjk5NywiZXhwIjoyMTA1OTk4OTk3fQ.om4q0_0K1NPPRR7OkBryAjlxBvM2cACMDj0e3qaREwY

# ── Application ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# development | production
ENVIRONMENT=development

# Cache TTL in seconds (default 300 = 5 minutes)
CACHE_TTL_SECONDS=300
